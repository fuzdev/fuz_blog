{
  "name": "@fuzdev/fuz_blog",
  "version": "0.35.0",
  "license": "0BSD",
  "description": "blog software from scratch with SvelteKit",
  "glyph": "🖊️",
  "logo": "logo.svg",
  "logo_alt": "a friendly yellow spider facing you",
  "homepage": "https://blog.fuz.dev/",
  "repository": "https://github.com/fuzdev/fuz_blog",
  "scripts": {
    "start": "gro dev",
    "dev": "gro dev",
    "build": "gro build",
    "check": "gro check",
    "test": "gro test",
    "preview": "vite preview",
    "deploy": "gro deploy"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#routes/*": "./src/routes/*"
  },
  "engines": {
    "node": ">=24.14"
  },
  "peerDependencies": {
    "@fuzdev/fuz_css": ">=0.70.0",
    "@fuzdev/fuz_mastodon": ">=0.45.1",
    "@fuzdev/fuz_schema": "^0.5.0",
    "@fuzdev/fuz_ui": ">=0.217.0",
    "@fuzdev/fuz_util": ">=0.77.0",
    "@fuzdev/gro": ">=0.220.0",
    "@sveltejs/kit": "^3",
    "svelte": "^5"
  },
  "peerDependenciesMeta": {
    "@fuzdev/fuz_mastodon": {
      "optional": true
    }
  },
  "dependencies": {
    "date-fns": "^4"
  },
  "devDependencies": {
    "@changesets/changelog-git": "^0.2.1",
    "@fuzdev/blake3-wasm": "^0.2.0",
    "@fuzdev/fuz_code": "^0.54.0",
    "@fuzdev/fuz_css": "^0.70.0",
    "@fuzdev/fuz_mastodon": "^0.45.1",
    "@fuzdev/fuz_schema": "^0.5.0",
    "@fuzdev/fuz_ui": "^0.217.0",
    "@fuzdev/fuz_util": "^0.77.0",
    "@fuzdev/gro": "^0.220.0",
    "@fuzdev/mdz": "^0.6.0",
    "@ryanatkn/eslint-config": "^0.13.1",
    "@sveltejs/acorn-typescript": "^1.0.9",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/estree": "^1.0.8",
    "@types/node": "^24.10.1",
    "@webref/css": "^8.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.13.1",
    "esm-env": "^1.2.2",
    "magic-string": "^0.30.21",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-docinfo": "^0.13.0",
    "svelte2tsx": "^0.7.52",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.0",
    "zimmerframe": "^1.1.4"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.ts": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.svelte": {
      "types": "./dist/*.svelte.d.ts",
      "svelte": "./dist/*.svelte",
      "default": "./dist/*.svelte"
    }
  }
}
